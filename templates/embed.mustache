{{!
    @template filter_peertube/embed
    Centered and responsive PeerTube iFrame embed.

    Context variables:
    * embedurl - The full embed URL of the PeerTube video.

    Example context (json):
    {
        "embedurl": "https://peertube.example.com/videos/embed/12345"
    }
}}

{{! Outer wrapper to center the video alignment. }}
<div style="text-align: center;">
    {{! Responsive container maintaining a 16:9 aspect ratio and fitting mobile screens. }}
    <div style="position: relative; width: 100%; max-width: 640px; margin: 0 auto; aspect-ratio: 16 / 9;">
        {{! Iframe element embedding the video with secure sandbox permissions and fullscreen support. }}
        <iframe style="border: 0px; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"
                title="{{#str}}iframetitle, filter_peertube{{/str}}"
                src="{{embedurl}}"
                loading="lazy"
                sandbox="allow-scripts allow-same-origin allow-popups"
                allow="fullscreen"></iframe>
    </div>
</div>
